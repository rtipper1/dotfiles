theme = Everforest Dark Hard

font-family = JetBrainsMonoNL Nerd Font

font-size=13
font-thicken=true
font-thicken-strength = 1
adjust-cell-height = 1

# Opaque by default. Floating terminals override this via CLI
# (see hypr binds: Super+Shift+Return).
background-opacity = 1
background-blur=true

fullscreen = false

window-padding-x = 10
window-padding-y = 5

copy-on-select = true

mouse-hide-while-typing=true
